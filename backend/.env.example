APP_NAME=Semantic Space Studio API
APP_VERSION=1.0.0
ENVIRONMENT=development
MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
MODEL_DISPLAY_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
MAX_SEQUENCE_LENGTH=256
# Comma-separated frontend origins allowed by CORS (trailing slashes stripped automatically)
# In production (ENVIRONMENT=production), only origins in FRONTEND_URL / CORS_ORIGINS are allowed.
FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS=https://your-frontend.up.railway.app
# Optional Railway volume paths (mount 500MB+ volume at /data, never over /app/data):
# Keep HF_HOME on container ephemeral storage when /data is a small persistent volume!
# ARTIFACTS_DIR=/data/artifacts
# HF_HOME=/tmp/huggingface
# EMOTION_REVIEWS_DB_PATH=/data/artifacts/emotion_reviews.db
# LOW_MEMORY_MODE=true
UMAP_DIMENSIONS=3
UMAP_N_NEIGHBORS=15
UMAP_MIN_DIST=0.1
UMAP_METRIC=cosine
UMAP_RANDOM_STATE=42
DEFAULT_TOP_K_NEIGHBORS=5
LOG_LEVEL=INFO
